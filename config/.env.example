# Copy this file to config/.env and fill in your own keys.
# config/.env is what the code actually reads - .env.example is just the template
# (and is safe to keep in version control; .env itself never should be).

# --- Required for Phase 2/3 model calls ---
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Optional: preferred automatically over GROQ_API_KEY for Llama-3 if set
# (src/models.py Llama3Wrapper) - use this if Groq's free tier can't sustain
# your call volume and its paid Developer tier is closed to new signups.
# Same underlying model (Llama-3.3-70B), different host. Sign up at
# deepinfra.com (no card required, $1 free credit) and generate a key at
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# --- Optional: only needed to unlock 3 gated FinBen datasets (FinQA, Causal
# Detection, ECTSum). Free HuggingFace account + one-time click-through
# agreement on each dataset page - see config/task_config.py docstring.
HF_TOKEN=
